{
  "regions": [
    "bom1"
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?:index\\.html|manifest\\.webmanifest|sw\\.js)?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "__Secure-better-auth.session_token"
        }
      ],
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "better-auth.session_token"
        }
      ],
      "destination": "/dashboard",
      "permanent": false
    }
  ]
}
